# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://swims:swims_dev_password@localhost:5432/swims
DATABASE_AUDIT_URL=postgresql://swims_audit:swims_audit_password@localhost:5432/swims

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_REFRESH_SECRET=change-me-to-another-64-char-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Encryption ────────────────────────────────────────
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string-64-chars

# ── S3 / MinIO ────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=swims_minio
S3_SECRET_KEY=swims_minio_password
S3_BUCKET=swims-media
S3_REGION=us-east-1

# ── App ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
