FROM node:20-alpine

WORKDIR /app

# Install dependencies needed for node-gyp and native modules if any
RUN apk add --no-cache python3 make g++

# Copy package.json files first to leverage Docker cache
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
COPY shared/package.json ./shared/

# Install dependencies
ENV npm_config_registry=https://mirrors.tencentyun.com/npm
RUN npm ci

# Copy the rest of the application code
COPY . .

# We will use docker-compose override to specify the exact dev command
CMD ["npm", "run", "dev"]
